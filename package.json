{
  "name": "hangout",
  "version": "1.0.1",
  "description": "Voice and text chat for two",
  "author": "Hangout",
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "peerjs": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hangout.app",
    "productName": "Hangout",
    "files": ["**/*", "!dist/**", "!.github/**", "!README.md"],
    "directories": { "output": "dist" },
    "publish": {
      "provider": "github",
         "owner": "sb-fivem",
      "repo": "hangout",
      "releaseType": "release"
    },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "signAndEditExecutable": false },
    "nsis": { "oneClick": true, "perMachine": false, "artifactName": "Hangout-Setup-${version}.exe" },
    "mac": { "identity": null, "target": [{ "target": "zip", "arch": ["x64", "arm64"] }] }
  }
}
